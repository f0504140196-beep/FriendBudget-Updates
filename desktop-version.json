ing('he-IL'));if(x.note)p.push('— '+x.note);return p.join(' ');}).filter(Boolean);}catch(e){} localStorage.setItem(FINANCIAL_REMINDERS_TEXT_KEY,lines.join('\\n')); }\n        function renderFinancialReminders(){migrateFinancialRemindersToFreeText();const b=document.getElementById('financialRemindersFreeText');if(b&&document.activeElement!==b)b.value=localStorage.getItem(FINANCIAL_REMINDERS_TEXT_KEY)||'';const s=document.getElementById('financialRemindersSaveStatus');if(s)s.textContent='נשמר אוטומטית';}\n        function saveFinancialRemindersFreeText(){const b=document.getElementById('financialRemindersFreeText');if(!b)return;localStorage.setItem(FINANCIAL_REMINDERS_TEXT_KEY,b.value);const s=document.getElementById('financialRemindersSaveStatus');if(s)s.textContent='✓ נשמר אוטומטית';}\n        function clearFinancialRemindersFreeText(){if(!confirm('לנקות את כל התזכורות?'))return;const b=document.getElementById('financialRemindersFreeText');if(b)b.value='';localStorage.setItem(FINANCIAL_REMINDERS_TEXT_KEY,'');}\n\n        function switchTab(tabId) {","expectedCount":1}]}]},{"from":"1.6.7","to":"1.6.8","files":[{"target":"index.html","beforeSha256":"8c8a1f51dc57e98903086218ab0be2f6335c2f7d309f3e2ffaba1cf11bff0cbb","afterSha256":"d7ae675e0a4799f6ed4403238520e0a064a49d4ba2a01e0402e25489944e6b0d","operations":[{"find":"onclick=\"compactRenameCategory('${cat.replace(/'/g, \\\"\\\\'\\\")}')\"","replace":"onclick=\"compactRenameCategory(decodeURIComponent('${encodeURIComponent(cat)}'))\"","expectedCount":1},{"find":"onclick=\"compactAddSubcategory('${cat.replace(/'/g, \\\"\\\\'\\\")}')\"","replace":"onclick=\"compactAddSubcategory(decodeURIComponent('${encodeURIComponent(cat)}'))\"","expectedCount":1},{"find":"onclick=\"compactDeleteCategory('${cat.replace(/'/g, \\\"\\\\'\\\")}')\"","replace":"onclick=\"compactDeleteCategory(decodeURIComponent('${encodeURIComponent(cat)}'))\"","expectedCount":1},{"find":"onclick=\"compactRenameSubcategory('${cat.replace(/'/g, \\\"\\\\'\\\")